  "designCalculations": [
    {
      "name": "6000 m 海水静水外压",
      "type": "hydrostatic-pressure",
      "input": {
        "depthM": 6000,
        "densityKgM3": 1025,
        "gravityMS2": 9.80665,
        "safetyFactor": 1.5
      },
      "expect": [
        { "path": "pressureMPa", "approx": 60.3108975, "tolerance": 0.0001 },
        {
          "path": "designPressureMPa",
          "approx": 90.46634625,
          "tolerance": 0.0001
        }
      ]
    },
    {
      "name": "薄壁圆柱壳初始厚度",
      "type": "preliminary-thickness",
      "input": {
        "innerRadiusM": 1.2,
        "pressureMPa": 60,
        "allowableHoopStressMPa": 900,
        "safetyFactor": 1.5
      },
      "expect": [
        { "path": "requiredThicknessMm", "approx": 120, "tolerance": 0.001 }
      ]
    },
    {
      "name": "铺层比例统计",
      "type": "layup-summary",
      "input": {
        "plies": [
          { "angleDeg": 90, "thicknessMm": 0.25, "materialName": "T700/Epoxy" },
          { "angleDeg": 45, "thicknessMm": 0.25, "materialName": "T700/Epoxy" },
          {
            "angleDeg": -45,
            "thicknessMm": 0.25,
            "materialName": "T700/Epoxy"
          },
          { "angleDeg": 0, "thicknessMm": 0.25, "materialName": "T700/Epoxy" }
        ]
      },
      "expect": [
        { "path": "plyCount", "equals": 4 },
        { "path": "totalThicknessMm", "approx": 1, "tolerance": 0.0001 }
      ]
    },
    {
      "name": "Tsai-Wu 失效指数",
      "type": "tsai-wu",
      "input": {
        "stress": { "sigma1MPa": 450, "sigma2MPa": 20, "tau12MPa": 30 },
        "strengths": {
          "xtMPa": 1500,
          "xcMPa": 1000,
          "ytMPa": 50,
          "ycMPa": 150,
          "s12MPa": 80
        },
        "interactionCoefficient": -0.5
      },
      "expect": [
        { "path": "failureIndex", "min": 0 },
        { "path": "reserveFactor", "min": 0 }
      ]
    },
    {
      "name": "铺层角度候选搜索",
      "type": "layup-angle-search",
      "input": {
        "lamina": {
          "e1GPa": 135,
          "e2GPa": 10,
          "g12GPa": 5,
          "nu12": 0.3
        },
        "angleCandidatesDeg": [15, 30, 45, 60, 75],
        "plyThicknessMm": 0.25,
        "anglePairRepeats": 4,
        "hoopPliesPerSide": 2,
        "mirrorSymmetric": true,
        "materialName": "T700/Epoxy",
        "objectiveWeights": {
          "hoopStiffness": 1,
          "axialStiffness": 0.2,
          "shearStiffness": 0.2,
          "couplingPenalty": 1
        },
        "topK": 3
      },
      "expect": [
        { "path": "searchSpace.candidateCount", "equals": 5 },
        { "path": "best.plyCount", "equals": 24 },
        { "path": "best.effectiveEngineeringConstants.eyGPa", "min": 1 }
      ]
    },
    {
      "name": "多目标方案筛选",
      "type": "multi-objective-screening",
      "input": {
        "candidates": [
          {
            "id": "A",
            "massKg": 1200,
            "thicknessMm": 90,
            "failureIndex": 0.82,
            "reserveFactor": 1.22,
            "manufacturabilityScore": 0.8
          },
          {
            "id": "B",
            "massKg": 980,
            "thicknessMm": 78,
            "failureIndex": 0.96,
            "reserveFactor": 1.04,
            "manufacturabilityScore": 0.65
          },
          {
            "id": "C",
            "massKg": 1350,
            "thicknessMm": 105,
            "failureIndex": 0.62,
            "reserveFactor": 1.61,
            "manufacturabilityScore": 0.9
          }
        ],
        "objectives": [
          { "metric": "massKg", "direction": "minimize", "weight": 1 },
          { "metric": "failureIndex", "direction": "minimize", "weight": 2 },
          {
            "metric": "manufacturabilityScore",
            "direction": "maximize",
            "weight": 0.5
          }
        ],
        "topK": 3
      },
      "expect": [
        { "path": "ranked.0.score", "min": 0 },
        { "path": "ranked.0.objectiveValues.0.normalized", "min": 0 }
      ]
    },
    {
      "name": "参数敏感性分析",
      "type": "parameter-sensitivity",
      "input": {
        "calculationType": "preliminary-thickness",
        "baseInput": {
          "innerRadiusM": 1.2,
          "pressureMPa": 60,
          "allowableHoopStressMPa": 900,
          "safetyFactor": 1.5
        },
        "parameterPath": "pressureMPa",
        "values": [40, 60, 80],
        "metricPath": "requiredThicknessMm"
      },
      "expect": [
        { "path": "baseMetricValue", "approx": 120, "tolerance": 0.001 },
        { "path": "samples.1.metricValue", "approx": 120, "tolerance": 0.001 }
      ]
    }
  ],
