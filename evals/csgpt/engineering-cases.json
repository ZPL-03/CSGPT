{
  "ragKg": [
    {
      "name": "复合材料耐压壳屈曲检索",
      "query": "复合材料耐压壳 外压 屈曲 设计",
      "minDocumentSources": 1,
      "forbiddenPatterns": [
        "[a-f0-9]{20,}\\\\.(pdf|docx?|pptx?|xlsx?)",
        "chunk_id",
        "record_id",
        "内部路径"
      ]
    }
  ],
  "knowledgeGraph": [
    {
      "name": "压力容器查询子图",
      "query": "composite pressure vessel buckling",
      "minNodes": 2,
      "minEdges": 1
    }
  ],
  "fileExtraction": [
    {
      "name": "UTF-8 文本解析",
      "fileName": "pressure-vessel-notes.txt",
      "mimeType": "text/plain",
      "content": "复合材料压力容器外压屈曲设计记录\\n半径 1200 mm，深度 6000 m。",
      "expectedIncludes": [
        "复合材料压力容器",
        "6000 m"
      ],
      "parser": "text"
    },
    {
      "name": "CSV 表格解析",
      "fileName": "layup-table.csv",
      "mimeType": "text/csv",
      "content": "angle,thickness,material\\n90,0.25,T700/Epoxy\\n45,0.25,T700/Epoxy\\n",
      "expectedIncludes": [
        "angle",
        "T700/Epoxy"
      ],
      "parser": "csv"
    }
  ],
  "fileContextIds": [
    {
      "name": "附件 URL 提取文件 ID",
      "urls": [
        "/api/files/cm-file-001",
        "https://csgpt.ipen03.com/api/files/cm-file-002?download=1",
        "/api/other/cm-file-003",
        "/api/files/cm-file-001"
      ],
      "expectedIds": [
        "cm-file-001",
        "cm-file-002"
      ]
    }
  ],
  "researchModes": [
    {
      "name": "标准模式使用联网 Provider",
      "mode": "standard",
      "provider": "tavily"
    },
    {
      "name": "专利模式使用联网 Provider",
      "mode": "patent",
      "provider": "tavily"
    },
    {
      "name": "学术 Provider 不支持专利模式",
      "mode": "patent",
      "provider": "semantic-scholar",
      "expectErrorIncludes": "不支持"
    }
  ],
  "onlineResearch": [
    {
      "name": "标准真实检索",
      "query": "composite pressure vessel ISO 11119 standard",
      "mode": "standard",
      "provider": "tavily",
      "minResults": 1
    },
    {
      "name": "专利真实检索",
      "query": "composite pressure vessel filament winding patent",
      "mode": "patent",
      "provider": "tavily",
      "minResults": 1
    }
  ],
  "databaseMigrations": [
    {
      "name": "Prisma 迁移包含消息结构化字段",
      "file": "prisma/migrations/20260611000100_csgpt_schema/migration.sql",
      "requiredIncludes": [
        "CREATE TABLE IF NOT EXISTS \"Message\"",
        "ALTER TABLE \"Message\""
      ]
    }
  ]
}
