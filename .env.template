# ===== CSGPT 核心配置 =====

# vLLM 推理服务地址（必填）
CSGPT_BASE_URL=http://your-vllm-server:8080/v1

# vLLM API 密钥（必填）
CSGPT_API_KEY=sk-your-api-key

# 默认模型名称（必填）
CSGPT_MODEL_NAME=gpt-5.5

# ===== 模型配置 =====

# 可用模型列表（+ 添加，- 隐藏，逗号分隔）
CUSTOM_MODELS=-all,+gpt-5.4,+gpt-5.4-mini

# 默认模型
DEFAULT_MODEL=gpt-5.5

# ===== 访问控制 =====

# 访问密码（可选，不设置则无需密码）
CODE=your-password

# ===== 其他配置（可选） =====

# 代理地址
# PROXY_URL=http://localhost:7890

# MCP 功能开关
# ENABLE_MCP=true

# 隐藏用户 API Key 输入框
# HIDE_USER_API_KEY=1

# 禁用 GPT-4 模型
# DISABLE_GPT4=1

# 自定义 OpenAI API 地址（如使用中转服务）
# BASE_URL=https://api.openai.com

# OpenAI Organization ID
# OPENAI_ORG_ID=

# Google Gemini Pro API
# GOOGLE_API_KEY=
# GOOGLE_URL=

# Anthropic Claude API
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_VERSION=
# ANTHROPIC_URL=

# 其他 Provider API Keys
# DEEPSEEK_API_KEY=
# SILICONFLOW_API_KEY=
# AI302_API_KEY=
